{
  "name": "@toolsync/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "No more setting up the same 100 tools when starting a new project",
  "homepage": "https://toolsync.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukasHechenberger/toolsync.git"
  },
  "license": "MIT",
  "author": "Lukas Hechenberger <npm@ls-age.com> (https://ls-age.com/)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "build": "turbo run build",
    "changesets:version": "changeset version && bun install",
    "check": "turbo run check",
    "check:format": "prettier --check .",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "ignore-sync": "ignore-sync .",
    "lint": "turbo run lint",
    "prepare": "toolsync prepare --config toolsync.json && ignore-sync .",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@repo/toolsync-plugins": "workspace:*",
    "@toolsync/builtin": "workspace:*",
    "@toolsync/cli": "workspace:*",
    "@turbo/gen": "^2.5.4",
    "ignore-sync": "^8.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-packagejson": "^2.5.15",
    "turbo": "^2.5.4"
  },
  "packageManager": "bun@1.3.6",
  "engines": {
    "node": ">=20.6.0"
  }
}
