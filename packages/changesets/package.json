{
  "name": "@toolsync/changesets",
  "version": "0.0.0",
  "private": true,
  "description": "A version of changesets that also works with bun",
  "homepage": "https://toolsync.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukasHechenberger/toolsync.git",
    "directory": "packages/changesets"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./changelog": {
      "import": {
        "types": "./out/changelog.d.ts",
        "default": "./out/changelog.js"
      },
      "require": {
        "types": "./out/changelog.d.cts",
        "default": "./out/changelog.cjs"
      }
    },
    "./commit": {
      "import": {
        "types": "./out/commit.d.ts",
        "default": "./out/commit.js"
      },
      "require": {
        "types": "./out/commit.d.cts",
        "default": "./out/commit.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "changeset": "./out/bin.js",
    "changesets": "./out/bin.js"
  },
  "files": [
    "out"
  ],
  "scripts": {
    "build": "bunup",
    "check:exports": "publint",
    "dev": "bunup --watch"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@manypkg/find-root": "^3.1.0",
    "@types/node": "^24",
    "bunup": "^0.16.20",
    "publint": "^0.3.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
