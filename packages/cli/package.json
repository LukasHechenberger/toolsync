{
  "name": "@toolsync/cli",
  "version": "0.4.0",
  "description": "The toolsync command line interface",
  "homepage": "https://toolsync.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukasHechenberger/toolsync.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "import": "./out/index.js",
      "default": "./out/index.js"
    },
    "./commands/init": {
      "types": "./out/commands/init.d.ts",
      "import": "./out/commands/init.js",
      "default": "./out/commands/init.js"
    }
  },
  "bin": {
    "toolsync": "./out/bin.js"
  },
  "files": [
    "CHANGELOG.md",
    "out/"
  ],
  "scripts": {
    "build": "bun run build:bun && bun run build:tsc",
    "build:bun": "bun build ./src/index.ts ./src/bin.ts ./src/commands/init.ts --splitting --sourcemap --production --target node --outdir ./out --external @toolsync/*",
    "build:tsc": "tsc --emitDeclarationOnly",
    "check:exports": "publint",
    "dev": "rslib build --watch",
    "test": "rstest",
    "update-readme": "node ./node_modules/@toolsync/template/out/bin.js README.md cli-usage \"\\`\\`\\`\n$(LOG_LEVEL=silent node ./out/bin.js --help)\n\\`\\`\\`\""
  },
  "dependencies": {
    "@toolsync/core": "workspace:^",
    "@toolsync/logger": "workspace:^",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "node-plop": "^0.32.0",
    "terminal-link": "^4.0.0"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@manypkg/tools": "^2.1.0",
    "@rslib/core": "^0.17.2",
    "@rstest/core": "^0.7.2",
    "@toolsync/builtin": "workspace:^",
    "@toolsync/template": "workspace:*",
    "@types/bun": "^1.3.5",
    "@types/node": "^22.15.30",
    "publint": "^0.3.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
