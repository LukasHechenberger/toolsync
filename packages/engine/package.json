{
  "name": "@toolsync/engine",
  "version": "0.0.0",
  "description": "A plugin engine, built for toolsync",
  "homepage": "https://toolsync.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukasHechenberger/toolsync.git",
    "directory": "packages/engine"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "out"
  ],
  "scripts": {
    "build": "bun run build:tsc && bun run build:bun && bun run build:readme",
    "build:bun": "bun build ./src/index.ts --sourcemap --production --outdir ./out --target node",
    "build:readme": "bun ./node_modules/@toolsync/template/out/bin.js README.md basic-usage \"$(cat ./examples/basic-usage.ts)\" --codeblock ts",
    "build:tsc": "tsc -p tsconfig.types.json",
    "check:exports": "publint"
  },
  "devDependencies": {
    "@toolsync/template": "workspace:^",
    "@types/bun": "latest",
    "publint": "^0.3.12"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
