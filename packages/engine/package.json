    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@toolsync/template": "workspace:^",
    "@types/bun": "latest",
    "bunup": "^0.16.17",
    "publint": "^0.3.12"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "publishConfig": {
    "access": "public"
