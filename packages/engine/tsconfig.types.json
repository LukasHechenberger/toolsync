{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "out",
    "declarationDir": "out",
    "rootDir": "src",
    "skipDefaultLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
