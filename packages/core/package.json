{
  "name": "@toolsync/core",
  "version": "0.1.4",
  "description": "Core functionality used in @toolsync/cli etc",
  "homepage": "https://toolsync.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukasHechenberger/toolsync.git",
    "directory": "packages/core"
  },
  "license": "MIT",
